# ===== LLM 配置（服务端持有，用户零配置）=====
# 协议：openai = OpenAI 兼容接口（DeepSeek/Kimi/Qwen/SiliconFlow 等）
#       anthropic = Anthropic Messages 协议
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-填入你的key
LLM_MODEL=deepseek-chat
# 备用 Key（可选，主 Key 失败时自动切换）
LLM_API_KEY2=
# 推理档位（仅推理型模型需要，如 deepseek-flash / deepseek-v4-pro）：low|high|max；留空则不传参
LLM_REASONING_EFFORT=
# 视觉能力（附件里的图片）：auto = 先按能看图处理，被 provider 拒绝就自动去掉图片重试并如实告诉孩子；
# off = 明确知道当前模型看不了图（如 deepseek-chat / deepseek-reasoner），一开始就不带图、直接说明；
# on = 强制按视觉模型处理。视觉模型示例：claude-sonnet-4-5 / gpt-4o / qwen-vl-max / glm-4v。
LLM_VISION=auto

# anthropic 协议示例：
# LLM_PROTOCOL=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ===== 可选工具 =====
# 联网搜索（可选）：配置 SEARCH_API_KEY + SEARCH_BASE_URL 走 Tavily 兼容端点；
# 未配置时自动改用必应网页结果解析（无需 Key）；两者都不可用则工具如实失败、不编造。
# 其余工具零配置：now 看时间（标准库）、weather 用 wttr.in、web_browse 直接抓网页正文。
SEARCH_API_KEY=
SEARCH_BASE_URL=
# 天气默认使用 wttr.in 免费服务，无需 Key

# ===== 语音合成 TTS（管家朗读，接小米 MiMo）=====
# 现在就能在 admin 后台「API 配置」里维护；写这里或后台 data/settings.json 都行，
# 后台配置优先于本文件。Key 去 https://platform.xiaomimimo.com 拿（限时免费）。
# 后四项留空 = 走 MiMo 官方默认值，也就是"不填也能直接跑"。
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_MODEL_DESIGN=
TTS_VOICE=
# 下面这些默认值都写在代码里，一般不用动；需要改也可以在后台调，改完立即生效
# TTS_ENABLED=1
# TTS_DEFAULT_MODE=design         # design=按文字描述生成音色；builtin=用内置音色（只有它有真流式）
# TTS_DEFAULT_STYLE=              # 音色描述（design 模式下就是喂给音色设计模型的提示词）
# TTS_FORMAT=mp3                  # mp3 | wav（pcm16 是裸流，浏览器播不了）
# TTS_MAX_CHARS=400               # 单次口播字数上限，超出在最近句号处收尾
# TTS_CARD_MAX_CHARS=120          # 方案卡只念一句引导稿的限长
# TTS_SPEAK_CARD=1
# TTS_SPEAK_GREETING=1
# TTS_SPEAK_BRIEFING=1
# 没配 TTS_API_KEY 时整条语音链路静默跳过，对话功能完全不受影响（前端也不会显示喇叭）

# ===== 后台管理 =====
# 用 admin 账号登录后，顶栏「后台」进入：API 配置 / 用户管理 / 档案管理 / 数据文件。
# 后台保存的配置落在 data/settings.json（不进 git），优先级高于本文件。

# ===== 演示账号初始口令（可选）=====
# 仅首次生成 data/users.json 时生效；线上部署务必改掉默认值
PANDA_CHILD_PASSWORD=
PANDA_PARENT_PASSWORD=
PANDA_ADMIN_PASSWORD=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
# 会话闲置回收秒数（默认 1800）：超过该时间没消息的会话释放内存，历史已落盘不受影响
# PANDA_SESSION_IDLE=1800

# ===== 附件（图片 / 文档）=====
# 单文件上限 MB（默认 10）、单档案配额 MB（默认 60）、单轮图片张数（默认 4）、
# 单轮图片总字节 MB（默认 8）、视觉长边像素（默认 1568）、扫描件 PDF 渲染页数（默认 3）
# PANDA_UPLOAD_MAX_MB=10
# PANDA_UPLOAD_QUOTA_MB=60
# PANDA_MAX_IMAGES_PER_TURN=4
# PANDA_IMAGE_TURN_MB=8
# PANDA_IMAGE_MAX_EDGE=1568
# PANDA_PDF_VISION_PAGES=3
# 跨轮附图：最近几轮带过附件的消息在新一轮里重新附上（0 = 关闭）
# PANDA_HISTORY_IMAGE_TURNS=2
