# ===== LLM 配置（服务端持有，用户零配置）=====
# 协议：openai = OpenAI 兼容接口（DeepSeek/Kimi/Qwen/SiliconFlow 等）
#       anthropic = Anthropic Messages 协议
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-填入你的key
LLM_MODEL=deepseek-chat
# 备用 Key（可选，主 Key 失败时自动切换）
LLM_API_KEY2=
# 推理档位（仅推理型模型需要，如 deepseek-flash / deepseek-v4-pro）：low|high|max；留空则不传参
LLM_REASONING_EFFORT=

# anthropic 协议示例：
# LLM_PROTOCOL=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ===== 可选工具 =====
# 联网搜索（可选，不配置则自动跳过该工具，其余功能不受影响）
SEARCH_API_KEY=
SEARCH_BASE_URL=
# 天气默认使用 wttr.in 免费服务，无需 Key

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
