# ---------- Python ----------
__pycache__/
*.py[cod]
.venv
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------- 前端 / 构建 ----------
node_modules/
dist/

# ---------- 本地环境与密钥 ----------
# .env.example 是入库的模板，其余 .env* 一律视为本地私密文件
.env
.env.*
!.env.example

# ---------- 系统与工具 ----------
.DS_Store
*.log
*.tmp
.idea/
.vscode/
.claude/settings.local.json

# ---------- 运行时数据（不入库） ----------
# 孩子档案默认全部忽略，演示档 child_xiaodou 例外保留入库
data/child_*/
!data/child_xiaodou/
# 会话历史是运行时文件，演示档也不入库
data/child_xiaodou/history.json
# TTS 合成出来的语音是二进制缓存，体积大且随时可再生成，一律不入库
data/child_*/voice_cache/
# 附件原图/文档是运行时上传的二进制，一次演示就能到十几 MB，同样不入库
data/child_*/files/
data/logs/
data/users.json
data/tokens.json
data/profiles.json
data/settings.json
