      "facts": [
        {
          "date": "2024-10-11",
          "text": "第一次上台讲故事，全程捏着衣角，从那以后一紧张就摆弄手指"
        },
        {
          "date": "2026-10-01",
          "text": "说到要去西安比赛，手指又开始在桌沿上一下一下地敲"
        },
        {
          "date": "2026-10-02",
          "text": "出发去西安比赛前说“我有点紧张”，紧张时手指又在敲桌子"
        },
        {
          "date": "2026-10-02",
          "text": "西客松出发前说“我有点紧张”，紧张时又在敲桌子、摆弄手指。"
        },
        {
          "date": "2026-10-02",
          "text": "西客松出发前主动说出“我有点紧张”，紧张时手又会敲桌子"
        },
        {
          "date": "2026-10-02",
          "text": "西客松比赛第一次出远门，出发前说有点紧张，跟着管家做了三次深呼吸。"
        }
      ]
    },
    {
      "id": "piano",
      "label": "钢琴",
      "domain": "aesthetics",
      "type": "interest",
      "status": "dropped",
      "first_seen": "2024-03-01",
      "last_seen": "2026-09-20",
      "weight": 7,
      "private": false,
      "facts": [
        {
          "date": "2024-03-01",
          "text": "二年级时学钢琴，一开始每天能坐住练 20 分钟"
        },
        {
          "date": "2024-06-20",
          "text": "学了三个月不练了，自己说“坐不住”，妈妈有点惋惜"
        },
        {
          "date": "2026-09-20",
          "text": "路过琴行听到琴声会停下来听一会儿，说“其实钢琴的声音挺好听的”"
        }
      ]
    },
    {
      "id": "accordion",
      "label": "手风琴",
      "domain": "aesthetics",
      "type": "interest",
      "status": "active",
      "first_seen": "2026-09-20",
      "last_seen": "2026-10-01",
      "weight": 2,
      "private": false,
      "facts": [
        {
          "date": "2026-09-20",
          "text": "刷到一个手风琴演奏的视频，说“这个好耶，我想学这个”"
        },
        {
          "date": "2026-10-01",
          "text": "真问起来了：“要多少钱？会不会又要坐很久？”——想学，但怕自己又是三分钟热度"
        }
      ]
    },
    {
      "id": "comic",
      "label": "画漫画",
      "domain": "aesthetics",
      "type": "interest",
      "status": "active",
      "first_seen": "2024-06-01",
      "last_seen": "2026-09-27",
      "weight": 19,
      "private": false,
      "facts": [
        {
          "date": "2024-06-01",
          "text": "儿童节收到一盒彩笔，开始画四格漫画，主角是一只叫“队长”的恐龙"
        },
        {
          "date": "2026-05-20",
          "text": "画了一本《恐龙队长的学校日记》，同学排队借着看"
        },
        {
          "date": "2026-09-27",
          "text": "说比赛的作品说明想用手画的分镜来讲，“不想写一大段字”"
        }
      ]
    },
    {
      "id": "secret_comic",
      "label": "悄悄话·课上偷画的恐龙漫画",
      "domain": "aesthetics",
      "type": "interest",
      "status": "active",
      "first_seen": "2026-09-22",
      "last_seen": "2026-09-29",
      "weight": 2,
      "private": true,
      "facts": [
        {
          "date": "2026-09-22",
          "text": "承认自己在数学本背面偷偷画漫画，画的是“上课打瞌睡的恐龙队长”"
        },
        {
          "date": "2026-09-29",
          "text": "把那张画藏在书包最里层，说“被老师发现会被没收，可是真的很好笑”"
        }
      ]
    },
    {
      "id": "new_pc",
      "label": "换电脑",
      "domain": "labor",
      "type": "goal",
      "status": "active",
      "first_seen": "2026-09-30",
      "last_seen": "2026-10-02",
      "weight": 15,
      "private": false,
      "facts": [
        {
          "date": "2026-09-30",
          "text": "电脑又卡住了，硬盘只剩约 3GB，他有点郁闷，说“它是不是快要退休了”"
        },
        {
          "date": "2026-10-02",
          "text": "想换一台能顺畅跑编程软件的新电脑，查过价格，说“知道不便宜，我自己出一部分”"
        },
        {
          "date": "2026-10-02",
          "text": "出发前先清笔记本空间、装好软件，保证作品能顺利跑起来"
        }
      ]
    },
    {
      "id": "save_money",
      "label": "攒钱",
      "domain": "labor",
      "type": "goal",
      "status": "active",
      "first_seen": "2026-09-30",
      "last_seen": "2026-10-02",
      "weight": 12,
      "private": false,
      "facts": [
        {
          "date": "2026-09-30",
          "text": "说要把零花钱攒起来，为换电脑出一份力，忍住没买零食和卡片"
        },
        {
          "date": "2026-10-01",
          "text": "数了数存钱罐，一共约 180 元，抱着罐子晃了半天很有成就感"
        },
        {
          "date": "2026-10-02",
          "text": "攒到 186 元，自己定的目标是 300 元，算下来完成了 62%，“还差一个多月”"
        }
      ]
    },
    {
      "id": "pocket_money",
      "label": "零花钱",
      "domain": "labor",
      "type": "trait",
      "status": "active",
      "first_seen": "2025-09-01",
      "last_seen": "2026-10-02",
      "weight": 8,
      "private": false,
      "facts": [
        {
          "date": "2025-09-01",
          "text": "升上三年级后每周 20 元零花钱，自己用小本子记进出，花超了会红着脸承认"
        },
        {
          "date": "2026-10-02",
          "text": "这一周一分没花，全投进存钱罐，说“攒钱比买卡片有意思”"
        }
      ]
    },
    {
      "id": "chore",
      "label": "帮妈妈摆碗筷",
      "domain": "labor",
      "type": "trait",
      "status": "active",
      "first_seen": "2025-01-10",
      "last_seen": "2026-10-01",
      "weight": 5,
      "private": false,
      "facts": [
        {
          "date": "2025-01-10",
          "text": "寒假开始每天饭前摆碗筷，理由很实在：“妈妈陪我上课太累了”"
        },
        {
          "date": "2026-10-01",
          "text": "国庆家里来客人，他摆了六副碗筷，摆完自己说了句“好耶”"
        }
      ]
    },
    {
      "id": "n_5d6fd099",
      "label": "漫画小计划",
      "domain": "aesthetics",
      "type": "goal",
      "status": "active",
      "first_seen": "2026-10-02",
      "last_seen": "2026-10-02",
