  "nodes": [
    {
      "id": "xiaodou",
      "label": "小豆",
      "domain": "ethics",
      "type": "person",
      "status": "active",
      "first_seen": "2024-03-01",
      "last_seen": "2026-10-02",
      "weight": 46,
      "private": false,
      "facts": [
        {
          "date": "2024-03-01",
          "text": "二年级下学期，妈妈开始给他记成长档案，说“这孩子好奇心太重，什么都想问一句为什么”"
        },
        {
          "date": "2025-09-01",
          "text": "升上三年级，开始每周 20 元零花钱，自己拿小本子记进出"
        },
        {
          "date": "2026-10-01",
          "text": "国庆节报名西客松后有点睡不着，说“好耶，但第一次离开威海去那么远，也有点怕”"
        },
        {
          "date": "2026-10-02",
          "text": "感冒还没好利索，一边咳嗽一边研究比赛规则，紧张时手指在桌边敲"
        }
      ]
    },
    {
      "id": "mom",
      "label": "妈妈",
      "domain": "ethics",
      "type": "person",
      "status": "active",
      "first_seen": "2024-03-01",
      "last_seen": "2026-10-01",
      "weight": 32,
      "private": false,
      "facts": [
        {
          "date": "2024-03-01",
          "text": "在威海陪读，兴趣班几乎每次都陪着去，兜里总装着纸巾和保温杯"
        },
        {
          "date": "2026-09-18",
          "text": "晚饭把胡萝卜切成小丁拌进肉馅里，说“看不见就不算吃胡萝卜”"
        },
        {
          "date": "2026-10-01",
          "text": "决定陪小豆去西安比赛，当晚就开始查从威海过去怎么走"
        }
      ]
    },
    {
      "id": "dad",
      "label": "爸爸",
      "domain": "ethics",
      "type": "person",
      "status": "active",
      "first_seen": "2024-03-01",
      "last_seen": "2026-10-02",
      "weight": 19,
      "private": false,
      "facts": [
        {
          "date": "2024-03-01",
          "text": "在外地工作，周五晚上回家、周日晚上走，视频电话固定在每晚八点"
        },
        {
          "date": "2026-08-16",
          "text": "专门请了一天假，带小豆去诸城看恐龙化石"
        },
        {
          "date": "2026-10-02",
          "text": "电话里说“比赛别紧张，把你会的那点全使出来就行”，还偷偷答应帮他保密礼物的事"
        }
      ]
    },
    {
      "id": "teacher_wang",
      "label": "机器人课王老师",
      "domain": "ethics",
      "type": "person",
      "status": "active",
      "first_seen": "2024-09-07",
      "last_seen": "2026-10-02",
      "weight": 11,
      "private": false,
      "facts": [
        {
          "date": "2024-09-07",
          "text": "第一次课就记住了小豆，说他“问的问题比谁都多，但问得都在点子上”"
        },
        {
          "date": "2026-09-27",
          "text": "课后跟妈妈说，小豆这次报西客松创意编程赛道挺合适，作品要能讲清楚"
        },
        {
          "date": "2026-10-02",
          "text": "在家长群里发提醒：学生证、笔记本电脑、充电器，创意编程赛道可以自带零件包"
        }
      ]
    },
    {
      "id": "good_yeah",
      "label": "口头语“好耶”",
      "domain": "ethics",
      "type": "trait",
      "status": "active",
      "first_seen": "2024-05-12",
      "last_seen": "2026-10-01",
      "weight": 13,
      "private": false,
      "facts": [
        {
          "date": "2024-05-12",
          "text": "第一次被记下来：听说周末要去海边，连喊了三声“好耶”"
        },
        {
          "date": "2026-06-01",
          "text": "儿童节拿到恐龙模型，还是那句“好耶”，只是这次喊得比小时候短"
        },
        {
          "date": "2026-10-01",
          "text": "报名成功那天说了句“好耶”，声音比平时小一点——心里其实还是紧张的"
        }
      ]
    },
    {
      "id": "three_minute",
      "label": "三分钟热度",
